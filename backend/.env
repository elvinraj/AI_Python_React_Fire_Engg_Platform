APP_NAME=AI Fire Engineering Platform
APP_ENV=development
APP_DEBUG=true

DATABASE_URL=mysql+pymysql://fireuser:firepassword@mysql:3306/fire_platform

JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=devstoreaccount1;AccountKey=local;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=fire-platform